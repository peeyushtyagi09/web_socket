# Ignore dependencies directory (safe for production, rebuild on deploy)
node_modules/

# Ignore build artifacts
dist/
build/
coverage/

# Ignore environment variable files (don't commit secrets)
.env
.env.*

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Ignore local development overrides and system files
*.local
.DS_Store

# Don't ignore package-lock.json in production-ready repositories
# (Lockfiles should be committed for production consistency)